{
  "name": "dsh-qq-moony",
  "version": "0.10.0",
  "description": "把 QQ 小号接进 DeepSeek Harness：收发消息、发表情包、发 QQ 空间说说、参与群聊，能自己找话题，自带启动与限速防封。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "qq",
    "napcat",
    "onebot"
  ],
  "license": "MIT",
  "author": "Seventy-JJ",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Seventy-JJ/dsh-qq-moony.git"
  },
  "homepage": "https://github.com/Seventy-JJ/dsh-qq-moony#readme",
  "bugs": {
    "url": "https://github.com/Seventy-JJ/dsh-qq-moony/issues"
  },
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "dsh": ">=0.1.7",
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ]
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
